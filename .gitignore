# ---------------------------------------------------------------- 构建产物
build/
dist/
out/
install/
output/
logs/

# 解压出来的三方源码（由 resources/*.zip 在首次 configure 时自动生成，可随时重建）
third_party/
_deps/

# ---------------------------------------------------------------- IDE
.vs/
.vscode/
.idea/
*.user
CMakeUserPresets.json
compile_commands.json

# ---------------------------------------------------------------- 大文件
# 三方库压缩包：体积大且可重新下载，地址见 resources/README.md
resources/*.zip

# 真实模型：体积大，用脚本或手动下载
models/real/

# ---------------------------------------------------------------- 本机环境
# 含 VM / 板子的账号密码，绝不进仓库
scripts/vm-env.sh

# ---------------------------------------------------------------- 本机评估/验证记录
# 审计报告与验证脚本里带本机绝对路径（D:\ProgramFiles\...），不适合入库
assess/

# ---------------------------------------------------------------- 杂项
*.log
*.obj
*.pdb
*.ilk
__pycache__/
*.pyc
.pytest_cache/

# Int8 量化产物：由 tools/quantize_models.py 生成，可随时重跑；中间文件尤其不该入库
models/int8/_work/
models/int8/*_qdq.onnx
models/int8/summary.json
# 示例产物（example_app_skeleton 默认写在当前目录）
skeleton_result.json
config.json
